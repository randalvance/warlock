{
	"name": "warlock",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
	"workspaceFolder": "${localWorkspaceFolder}",
	"mounts": [
		"source=warlock-${devcontainerId}-node-modules,target=${localWorkspaceFolder}/node_modules,type=volume",
		"source=warlock-${devcontainerId}-server-node-modules,target=${localWorkspaceFolder}/apps/server/node_modules,type=volume",
		"source=warlock-${devcontainerId}-web-node-modules,target=${localWorkspaceFolder}/apps/web/node_modules,type=volume"
	],
	"containerEnv": {
		"npm_config_store_dir": "${localWorkspaceFolder}/node_modules/.pnpm-store"
	},
	"remoteEnv": {
		"GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
		"GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
		"GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
		"GIT_COMMITTER_NAME": "${localEnv:GIT_COMMITTER_NAME}",
		"GIT_COMMITTER_EMAIL": "${localEnv:GIT_COMMITTER_EMAIL}"
	},
	"postCreateCommand": "sh .devcontainer/post-create.sh"
}
