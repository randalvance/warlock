{
	"name": "warlock",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.22"
	},
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"typecheck": "tsc && pnpm -r typecheck",
		"test": "pnpm -r test",
		"db:check": "pnpm --filter @warlock/server db:check",
		"smoke": "playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
